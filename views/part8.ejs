<%- include('partials/header.ejs') %>
<%- include('partials/navbar.ejs') %>

<section class="jojo-resume">
  <div>
    <img src="/img/josuke.png" alt="josuke-higashikata" />
  </div>

  <section class="jojo-resume-text">
    <h3>Part 8: JoJolion</h3>
    <p>
      Em 2011, após o grande terremoto e tsunami de Tōhoku devastarem a costa do Japão, formações geológicas misteriosas apelidadas de "Olhos da Parede" emergem nos arredores de Morioh. A universitária Yasuho Hirose encontra um rapaz enterrado sob o solo, privado de todas as suas memórias e portando uma estranha marca estelar. Adotado pela prestigiada família Higashikata com o nome de Josuke, ele se lança numa intrigante investigação para descobrir a sua verdadeira identidade, deparando-se com os segredos ancestrais da miraculosa fruta Locacaca e enfrentando a perigosa sociedade secreta dos Homens de Pedra.
    </p>
  </section>
</section>

<section class="form-section">
  <h2 class="section-title">Cadastrar Novo Personagem</h2>

  <div class="form-container">
    <form class="character-form" action="/part8/signup" method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label for="nome">Nome do Personagem</label>
          <input type="text" id="nome" name="nome" placeholder="Digite o nome do personagem" required />
        </div>

        <div class="form-group">
          <label for="stand">Stand</label>
          <input type="text" id="stand" name="stand" placeholder="Digite o nome do Stand" required />
        </div>

        <div class="form-group full-width">
          <label for="img">URL da Foto / Imagem</label>
          <input type="text" id="img" name="img" placeholder="Ex: /img/josuke-icon.jpg" required />
        </div>

        <div class="form-group full-width">
          <label for="desc">Descrição</label>
          <textarea id="desc" name="desc" rows="4" placeholder="Digite uma breve descrição do personagem..." required></textarea>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-submit">Cadastrar Personagem</button>
      </div>
    </form>
  </div>
</section>

<section class="characters-section">
  <h2 class="section-title">Destaque de Personagens</h2>
  
  <div class="table-container">
    <table class="characters-table">
      <thead>
        <tr>
          <th>Foto</th>
          <th>Nome</th>
          <th>Stand</th>
          <th>Descrição</th>
          <th colspan="2" class="col-actions-header">Ações:</th>
        </tr>
      </thead>
      <tbody>
        <% characters.forEach(character => { %>
          <tr>
            <td class="col-img">
              <img src="<%= character.img %>" alt="<%= character.nome %>" class="character-avatar" />
            </td>
            <td class="col-name">
              <strong><%= character.nome %></strong>
            </td>
            <td class="col-stand">
              <span class="stand-badge"><%= character.stand %></span>
            </td>
            <td class="col-desc">
              <%= character.desc %>
            </td>
            <td class="col-action">
              <button type="button" class="btn-action btn-edit">Editar</button>
            </td>
            <td class="col-action">
              <button type="button" class="btn-action btn-delete">Deletar</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

</body>
</html>

