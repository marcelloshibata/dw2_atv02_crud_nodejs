<%- include('partials/header.ejs') %>
<%- include('partials/navbar.ejs') %>

<section class="jojo-resume">
  <div>
    <img src="/img/Jolyne.png" alt="jolyne-kujo" />
  </div>

  <section class="jojo-resume-text">
    <h3>Part 6: Stone Ocean</h3>
    <p>
      Em 2011, na Flórida, Jolyne Cujoh é condenada injustamente a 15 anos de prisão no presídio de segurança máxima Green Dolphin Street. Lá, ela desperta seu Stand, Stone Free, através de um pingente enviado por seu pai distante, Jotaro Kujo. Quando Jotaro tenta resgatá-la, cai em uma armadilha armada pelo capelão do presídio, Padre Enrico Pucci, tendo suas memórias e seu Stand roubados em forma de discos pelo temível Whitesnake. Agora, Jolyne precisa liderar um grupo improvável de aliados para recuperar os discos de seu pai e impedir um plano de alcance cósmico arquitetado pela vontade póstuma de DIO.
    </p>
  </section>
</section>

<section class="form-section">
  <h2 class="section-title">Cadastrar Novo Personagem</h2>

  <div class="form-container">
    <form class="character-form" action="/part6/signup" method="POST">
      <div class="form-grid">
        <div class="form-group">
          <label for="nome">Nome do Personagem</label>
          <input type="text" id="nome" name="nome" placeholder="Digite o nome do personagem" required />
        </div>

        <div class="form-group">
          <label for="stand">Stand</label>
          <input type="text" id="stand" name="stand" placeholder="Digite o nome do Stand" required />
        </div>

        <div class="form-group full-width">
          <label for="img">URL da Foto / Imagem</label>
          <input type="text" id="img" name="img" placeholder="Ex: /img/jolyne-icon.jpg" required />
        </div>

        <div class="form-group full-width">
          <label for="desc">Descrição</label>
          <textarea id="desc" name="desc" rows="4" placeholder="Digite uma breve descrição do personagem..." required></textarea>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-submit">Cadastrar Personagem</button>
      </div>
    </form>
  </div>
</section>

<section class="characters-section">
  <h2 class="section-title">Destaque de Personagens</h2>
  
  <div class="table-container">
    <table class="characters-table">
      <thead>
        <tr>
          <th>Foto</th>
          <th>Nome</th>
          <th>Stand</th>
          <th>Descrição</th>
          <th colspan="2" class="col-actions-header">Ações:</th>
        </tr>
      </thead>
      <tbody>
        <% characters.forEach(character => { %>
          <tr>
            <td class="col-img">
              <img src="<%= character.img %>" alt="<%= character.nome %>" class="character-avatar" />
            </td>
            <td class="col-name">
              <strong><%= character.nome %></strong>
            </td>
            <td class="col-stand">
              <span class="stand-badge"><%= character.stand %></span>
            </td>
            <td class="col-desc">
              <%= character.desc %>
            </td>
            <td class="col-action">
              <button type="button" class="btn-action btn-edit">Editar</button>
            </td>
            <td class="col-action">
              <button type="button" class="btn-action btn-delete">Deletar</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

</body>
</html>